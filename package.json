{
    "name": "@ts-core/swagger",
    "version": "11.0.2",
    "description": "Framework-agnostic TypeScript decorators for Swagger/OpenAPI metadata, compatible with @nestjs/swagger",
    "main": "./cjs/public-api.js",
    "module": "./esm/public-api.js",
    "exports": {
        ".": {
            "import": "./esm/public-api.js",
            "require": "./cjs/public-api.js"
        }
    },
    "scripts": {},
    "author": {
        "name": "Renat Gubaev",
        "email": "renat.gubaev@gmail.com"
    },
    "license": "ISC",
    "dependencies": {
        "@ts-core/common": "~3.0.60"
    },
    "peerDependencies": {
        "reflect-metadata": ">=0.1.0"
    },
    "devDependencies": {
        "@types/node": "^14.14.31",
        "gulp-npm-module-publisher": "^3.0.5",
        "reflect-metadata": "^0.2.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ManhattanDoctor/ts-core-swagger.git"
    },
    "keywords": [
        "typescript",
        "swagger",
        "openapi",
        "decorators",
        "nestjs",
        "dto",
        "metadata"
    ],
    "bugs": {
        "url": "https://github.com/ManhattanDoctor/ts-core-swagger/issues"
    },
    "homepage": "https://github.com/ManhattanDoctor/ts-core-swagger#readme",
    "publishConfig": {
        "access": "public"
    }
}
